{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fitifact",
  "version": "0.1.0-rc.6",
  "identifier": "com.mattbaconz.fitifact",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run sidecar && npm run ui:dev",
    "beforeBuildCommand": "npm run sidecar && npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fitifact",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset: http://asset.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../../profiles": "profiles",
      "../FFMPEG-NOTICE.md": "FFMPEG-NOTICE.md"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ]
  }
}
