{
  "name": "fitifact-web",
  "version": "0.1.0-rc.6",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": "24.6.0",
    "npm": "11.5.1"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/fitifact-wasm --target web --out-dir ../../web/src/wasm --release",
    "dev": "vite",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:heic": "vitest run src/worker/heic-decoder.test.ts",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:heic": "playwright test --project=chromium-desktop --grep \"approved HEIC\"",
    "test:e2e:heic-off": "playwright test --project=chromium-desktop --grep \"off-gate HEIC\""
  },
  "dependencies": {
    "@tauri-apps/api": "2.9.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "libheif-js": "1.19.8",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wasm-pack": "0.15.0"
  }
}
