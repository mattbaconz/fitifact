      ],
      "sources": [
        {
          "id": "src-attachments",
          "note": "MP4 embeds when the video is H264, HEVC/H265, or AV1. For non-Nitro accounts the maximum upload is 20 MB (20000000 as published; Discord may enforce 20*1024*1024). Discord says it is experimenting with upload limits, so some accounts see larger caps.",
          "observed_at": "2026-10-17",
          "type": "official-doc",
          "url": "https://support.discord.com/hc/en-us/articles/25444343291031-File-Attachments-FAQ"
        },
        {
          "id": "src-fitifact-codec",
          "note": "Fitifact rule (D-032): encode H.264 video with AAC audio so every Discord client plays it. Discord's FAQ also lists HEVC/H.265 and AV1 in MP4; allowing them is an open owner decision.",
          "observed_at": "2026-10-17",
          "type": "fitifact-rule",
          "url": null
        },
        {
          "id": "src-fitifact-picture",
          "note": "Fitifact rule, not a destination statement: H.264 video plays reliably everywhere only as 8-bit 4:2:0 SDR. 10-bit, 4:2:2/4:4:4, and HDR H.264 often fail to play or show wrong colors, so they are re-encoded. Untagged video counts as SDR because players show it that way.",
          "observed_at": "2026-10-17",
          "type": "fitifact-rule",
          "url": null
        }
      ],
      "trust": "documented-with-rules"
