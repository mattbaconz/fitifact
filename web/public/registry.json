      ],
      "sources": [
        {
          "id": "src-size",
          "note": "\"For personal Gmail accounts, the limit is 25 MB.\" Over the limit, Gmail removes the attachment and adds a Google Drive link instead. Integer is 25000000 as published.",
          "observed_at": "2026-10-17",
          "type": "official-doc",
          "url": "https://support.google.com/mail/answer/6584"
        },
        {
          "id": "src-workspace",
          "note": "Workspace sending limits (25 MB for Business and Education) apply to message content and attachments before encoding, so base64/MIME growth does not count. Google does not say how personal accounts measure; this profile keeps the raw 25 MB.",
          "observed_at": "2026-10-17",
          "type": "official-doc",
          "url": "https://support.google.com/a/answer/166852"
        }
      ],
      "trust": "documented"
    },
